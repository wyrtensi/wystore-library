+// deliveryAppInfo keeps the manifest's version tied to the requested delivery.
+// Details can advance independently and cannot name an older delivered version.
+func deliveryAppInfo(info *play.AppInfo, versionCode int32) *play.AppInfo {
+	delivered := *info
+	if delivered.VersionCode != versionCode {
+		delivered.VersionCode = versionCode
+		delivered.VersionName = ""
+	}
+	return &delivered
+}
