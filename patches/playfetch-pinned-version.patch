diff --git a/cmd/playfetch/delivery_app_info_test.go b/cmd/playfetch/delivery_app_info_test.go
new file mode 100644
index 0000000..72a875c
--- /dev/null
+++ b/cmd/playfetch/delivery_app_info_test.go
@@ -0,0 +1,26 @@
+package main
+
+import (
+	"testing"
+
+	"github.com/Exmeaning/playfetch/internal/play"
+)
+
+func TestDeliveryAppInfoUsesDeliveredVersionWithoutMutatingDetails(t *testing.T) {
+	original := &play.AppInfo{Package: "org.example.app", VersionCode: 100, VersionName: "current", Free: true}
+	got := deliveryAppInfo(original, 101)
+	if got.VersionCode != 101 || got.VersionName != "" || got.Package != original.Package || !got.Free {
+		t.Fatalf("incorrect delivered metadata: %+v", got)
+	}
+	if original.VersionCode != 100 || original.VersionName != "current" {
+		t.Fatalf("details mutated: %+v", original)
+	}
+}
+
+func TestDeliveryAppInfoPreservesNameForMatchingVersion(t *testing.T) {
+	original := &play.AppInfo{Package: "org.example.app", VersionCode: 100, VersionName: "current"}
+	got := deliveryAppInfo(original, 100)
+	if got.VersionCode != 100 || got.VersionName != "current" || got == original {
+		t.Fatalf("incorrect delivered metadata: %+v", got)
+	}
+}
